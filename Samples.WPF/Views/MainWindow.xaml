<Window x:Class="Samples.WPF.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Samples.ViewModels" xmlns:m="https://github.com/MvvmAIO/Markup"
        Title="MvvmAIO.Markup — Samples" Width="720" Height="780" MinWidth="520"
        d:DataContext="{d:DesignInstance Type={x:Type vm:MainWindowViewModel}}" mc:Ignorable="d">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
        <Style x:Key="SampleButton" TargetType="Button">
            <Setter Property="Margin" Value="4" />
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
    </Window.Resources>

    <ScrollViewer Padding="16" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="各按钮的 CommandParameter 使用对应 m: 标记扩展；点击后在消息框中显示 CLR 类型与不变区域性字符串。" TextWrapping="Wrap"
                    Opacity="0.85" />

            <TextBlock Style="{StaticResource SectionTitle}" Text="Boolean" />
            <WrapPanel>
                <Button Style="{StaticResource SampleButton}" Content="True" Command="{Binding ShowMarkupValueCommand}"
                        ToolTip="{m:Boolean True}" CommandParameter="{m:Boolean True}" />
                <Button Style="{StaticResource SampleButton}" Content="False" Command="{Binding ShowMarkupValueCommand}"
                        ToolTip="{m:Boolean False}" CommandParameter="{m:Boolean False}" />
            </WrapPanel>

            <TextBlock Style="{StaticResource SectionTitle}" Text="整型（有符号）" />
            <WrapPanel>
                <Button Style="{StaticResource SampleButton}" Content="SByte -1"
                        Command="{Binding ShowMarkupValueCommand}" ToolTip="{m:SByte -1}"
                        CommandParameter="{m:SByte -1}" />
                <Button Style="{StaticResource SampleButton}" Content="Int16 -1000"
                        Command="{Binding ShowMarkupValueCommand}" ToolTip="{m:Int16 -1000}"
                        CommandParameter="{m:Int16 -1000}" />
                <Button Style="{StaticResource SampleButton}" Content="Int32 2147483647"
                        Command="{Binding ShowMarkupValueCommand}" ToolTip="{m:Int32 2147483647}"
                        CommandParameter="{m:Int32 2147483647}" />
                <Button Style="{StaticResource SampleButton}" Content="Int64 9223372036854775807"
                        Command="{Binding ShowMarkupValueCommand}" ToolTip="{m:Int64 9223372036854775807}"
                        CommandParameter="{m:Int64 9223372036854775807}" />
            </WrapPanel>

            <TextBlock Style="{StaticResource SectionTitle}" Text="整型（无符号 / Byte）" />
            <WrapPanel>
                <Button Style="{StaticResource SampleButton}" Content="Byte 255"
                        Command="{Binding ShowMarkupValueCommand}" ToolTip="{m:Byte 255}"
                        CommandParameter="{m:Byte 255}" />
                <Button Style="{StaticResource SampleButton}" Content="UInt16 65535"
                        Command="{Binding ShowMarkupValueCommand}" ToolTip="{m:UInt16 65535}"
                        CommandParameter="{m:UInt16 65535}" />
                <Button Style="{StaticResource SampleButton}" Content="UInt32 4000000000"
                        Command="{Binding ShowMarkupValueCommand}" ToolTip="{m:UInt32 4000000000}"
                        CommandParameter="{m:UInt32 4000000000}" />
                <Button Style="{StaticResource SampleButton}" Content="UInt64 max"
                        Command="{Binding ShowMarkupValueCommand}" ToolTip="{m:UInt64 18446744073709551615}"
                        CommandParameter="{m:UInt64 18446744073709551615}" />
            </WrapPanel>

            <TextBlock Style="{StaticResource SectionTitle}" Text="浮点与 Decimal" />
            <WrapPanel>
                <Button Style="{StaticResource SampleButton}" Content="Single"
                        Command="{Binding ShowMarkupValueCommand}" ToolTip="{m:Single 3.1415927}"
                        CommandParameter="{m:Single 3.1415927}" />
                <Button Style="{StaticResource SampleButton}" Content="Double"
                        Command="{Binding ShowMarkupValueCommand}" ToolTip="{m:Double 2.718281828459045}"
                        CommandParameter="{m:Double 2.718281828459045}" />
                <Button Style="{StaticResource SampleButton}" Content="Decimal"
                        Command="{Binding ShowMarkupValueCommand}" ToolTip="{m:Decimal 1234567890.123456789}"
                        CommandParameter="{m:Decimal 1234567890.123456789}" />
            </WrapPanel>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Char" />
            <WrapPanel>
                <Button Style="{StaticResource SampleButton}" Content="Char Z"
                        Command="{Binding ShowMarkupValueCommand}" ToolTip="{m:Char Z}" CommandParameter="{m:Char Z}" />
                <Button Style="{StaticResource SampleButton}" Content="Char +"
                        Command="{Binding ShowMarkupValueCommand}" ToolTip="{m:Char +}" CommandParameter="{m:Char +}" />
            </WrapPanel>

            <TextBlock Style="{StaticResource SectionTitle}" Text="日期与时间" />
            <WrapPanel>
                <Button Style="{StaticResource SampleButton}" Content="DateTime"
                        Command="{Binding ShowMarkupValueCommand}" ToolTip="{m:DateTime 2026-05-14}"
                        CommandParameter="{m:DateTime 2026-05-14}" />
                <Button Style="{StaticResource SampleButton}" Content="TimeSpan"
                        Command="{Binding ShowMarkupValueCommand}" ToolTip="{m:TimeSpan 1.02:03:04.005}"
                        CommandParameter="{m:TimeSpan 1.02:03:04.005}" />
            </WrapPanel>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Guid" />
            <WrapPanel>
                <Button Style="{StaticResource SampleButton}" Content="Guid" Command="{Binding ShowMarkupValueCommand}"
                        ToolTip="{m:Guid a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11}"
                        CommandParameter="{m:Guid a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11}" />
            </WrapPanel>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Enum" />
            <WrapPanel>
                <Button Style="{StaticResource SampleButton}" Content="Enum TextAlignment ceNter"
                        Command="{Binding ShowMarkupValueCommand}"
                        ToolTip="{Binding RelativeSource={RelativeSource Mode=Self},Path=CommandParameter}"
                        CommandParameter="{m:Enum {x:Type TextAlignment},ceNter}" />

                <Button Style="{StaticResource SampleButton}" Content="Enum TextAlignment 1"
                        Command="{Binding ShowMarkupValueCommand}"
                        ToolTip="{Binding RelativeSource={RelativeSource Mode=Self},Path=CommandParameter}"
                        CommandParameter="{m:Enum {x:Type TextAlignment},1}" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
