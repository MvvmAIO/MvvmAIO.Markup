<Window x:Class="Samples.WPF.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Samples.ViewModels" 
        Title="MvvmAIO.Markup — Samples" Width="720" Height="780" MinWidth="520"
        d:DataContext="{d:DesignInstance Type={x:Type vm:MainWindowViewModel}}" mc:Ignorable="d">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
        <Style x:Key="SampleButton" TargetType="Button">
            <Setter Property="Margin" Value="4" />
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
    </Window.Resources>

    <ScrollViewer Padding="16" VerticalScrollBarVisibility="Auto" >
        <StackPanel>
            <TextBlock Text="各按钮的 CommandParameter 使用对应 x: 标记扩展（MvvmAIO.Markup 已 XmlnsDefinition 到 winfx/2006/xaml）；点击后在消息框中显示 CLR 类型与不变区域性字符串。" TextWrapping="Wrap"
                    Opacity="0.85" />

            <TextBlock Style="{StaticResource SectionTitle}" Text="Boolean" />
            <WrapPanel>
                <Button Style="{StaticResource SampleButton}" Content="True" Command="{Binding ShowMarkupValueCommand}"
                        ToolTip="{x:Boolean True}" CommandParameter="{x:Boolean True}" />
                <Button Style="{StaticResource SampleButton}" Content="False" Command="{Binding ShowMarkupValueCommand}"
                        ToolTip="{x:Boolean False}" CommandParameter="{x:Boolean False}" />
            </WrapPanel>

            <TextBlock Style="{StaticResource SectionTitle}" Text="整型（有符号）" />
            <WrapPanel>
                <Button Style="{StaticResource SampleButton}" Content="SByte -1"
                        Command="{Binding ShowMarkupValueCommand}" ToolTip="{x:SByte -1}"
                        CommandParameter="{x:SByte -1}" />
                <Button Style="{StaticResource SampleButton}" Content="Int16 -1000"
                        Command="{Binding ShowMarkupValueCommand}" ToolTip="{x:Int16 -1000}"
                        CommandParameter="{x:Int16 -1000}" />
                <Button Style="{StaticResource SampleButton}" Content="Int32 2147483647"
                        Command="{Binding ShowMarkupValueCommand}" ToolTip="{x:Int32 2147483647}"
                        CommandParameter="{x:Int32 2147483647}" />
                <Button Style="{StaticResource SampleButton}" Content="Int64 9223372036854775807"
                        Command="{Binding ShowMarkupValueCommand}" ToolTip="{x:Int64 9223372036854775807}"
                        CommandParameter="{x:Int64 9223372036854775807}" />
            </WrapPanel>

            <TextBlock Style="{StaticResource SectionTitle}" Text="整型（无符号 / Byte）" />
            <WrapPanel>
                <Button Style="{StaticResource SampleButton}" Content="Byte 255"
                        Command="{Binding ShowMarkupValueCommand}" ToolTip="{x:Byte 255}"
                        CommandParameter="{x:Byte 255}" />
                <Button Style="{StaticResource SampleButton}" Content="UInt16 65535"
                        Command="{Binding ShowMarkupValueCommand}" ToolTip="{x:UInt16 65535}"
                        CommandParameter="{x:UInt16 65535}" />
                <Button Style="{StaticResource SampleButton}" Content="UInt32 4000000000"
                        Command="{Binding ShowMarkupValueCommand}" ToolTip="{x:UInt32 4000000000}"
                        CommandParameter="{x:UInt32 4000000000}" />
                <Button Style="{StaticResource SampleButton}" Content="UInt64 max"
                        Command="{Binding ShowMarkupValueCommand}" ToolTip="{x:UInt64 18446744073709551615}"
                        CommandParameter="{x:UInt64 18446744073709551615}" />
            </WrapPanel>

            <TextBlock Style="{StaticResource SectionTitle}" Text="浮点与 Decimal" />
            <WrapPanel>
                <Button Style="{StaticResource SampleButton}" Content="Single"
                        Command="{Binding ShowMarkupValueCommand}" ToolTip="{x:Single 3.1415927}"
                        CommandParameter="{x:Single 3.1415927}" />
                <Button Style="{StaticResource SampleButton}" Content="Double"
                        Command="{Binding ShowMarkupValueCommand}" ToolTip="{x:Double 2.718281828459045}"
                        CommandParameter="{x:Double 2.718281828459045}" />
                <Button Style="{StaticResource SampleButton}" Content="Decimal"
                        Command="{Binding ShowMarkupValueCommand}" ToolTip="{x:Decimal 1234567890.123456789}"
                        CommandParameter="{x:Decimal 1234567890.123456789}" />
            </WrapPanel>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Char" />
            <WrapPanel>
                <Button Style="{StaticResource SampleButton}" Content="Char Z"
                        Command="{Binding ShowMarkupValueCommand}" ToolTip="{x:Char Z}" CommandParameter="{x:Char Z}" />
                <Button Style="{StaticResource SampleButton}" Content="Char +"
                        Command="{Binding ShowMarkupValueCommand}" ToolTip="{x:Char +}" CommandParameter="{x:Char +}" />
            </WrapPanel>

            <TextBlock Style="{StaticResource SectionTitle}" Text="日期与时间" />
            <WrapPanel>
                <Button Style="{StaticResource SampleButton}" Content="DateTime"
                        Command="{Binding ShowMarkupValueCommand}" ToolTip="{x:DateTime 2026-05-14}"
                        CommandParameter="{x:DateTime 2026-05-14}" />
                <Button Style="{StaticResource SampleButton}" Content="TimeSpan"
                        Command="{Binding ShowMarkupValueCommand}" ToolTip="{x:TimeSpan 1.02:03:04.005}"
                        CommandParameter="{x:TimeSpan 1.02:03:04.005}" />
            </WrapPanel>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Guid" />
            <WrapPanel>
                <Button Style="{StaticResource SampleButton}" Content="Guid" Command="{Binding ShowMarkupValueCommand}"
                        ToolTip="{x:Guid a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11}"
                        CommandParameter="{x:Guid a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11}" />
            </WrapPanel>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Enum" />
            <WrapPanel>
                <Button Style="{StaticResource SampleButton}" Content="Enum TextAlignment ceNter"
                        Command="{Binding ShowMarkupValueCommand}"
                        ToolTip="{Binding RelativeSource={RelativeSource Mode=Self},Path=CommandParameter}"
                        CommandParameter="{x:Enum {x:Type TextAlignment},ceNter}" />

                <Button Style="{StaticResource SampleButton}" Content="Enum TextAlignment 1"
                        Command="{Binding ShowMarkupValueCommand}"
                        ToolTip="{Binding RelativeSource={RelativeSource Mode=Self},Path=CommandParameter}"
                        CommandParameter="{x:Enum {x:Type TextAlignment},1}" />
            </WrapPanel>

            <TextBlock Style="{StaticResource SectionTitle}" Text="String / Uri / CultureInfo" />
            <WrapPanel>
                <Button Style="{StaticResource SampleButton}" Content="String"
                        Command="{Binding ShowMarkupValueCommand}" CommandParameter="{x:String Save}" />
                <Button Style="{StaticResource SampleButton}" Content="Uri"
                        Command="{Binding ShowMarkupValueCommand}"
                        CommandParameter="{x:Uri https://github.com/MvvmAIO/MvvmAIO.Markup}" />
                <Button Style="{StaticResource SampleButton}" Content="CultureInfo"
                        Command="{Binding ShowMarkupValueCommand}" CommandParameter="{x:CultureInfo 'zh-CN'}" />
            </WrapPanel>

            <TextBlock Style="{StaticResource SectionTitle}" Text="布局与几何（WPF）" />
            <WrapPanel>
                <Button Style="{StaticResource SampleButton}" Content="Thickness"
                        Command="{Binding ShowMarkupValueCommand}" CommandParameter="{x:Thickness 8}" />
                <Button Style="{StaticResource SampleButton}" Content="Point"
                        Command="{Binding ShowMarkupValueCommand}" CommandParameter="{x:Point '10,20'}" />
                <Button Style="{StaticResource SampleButton}" Content="Size"
                        Command="{Binding ShowMarkupValueCommand}" CommandParameter="{x:Size '100,50'}" />
                <Button Style="{StaticResource SampleButton}" Content="Rect"
                        Command="{Binding ShowMarkupValueCommand}" CommandParameter="{x:Rect '0,0,100,50'}" />
                <Button Style="{StaticResource SampleButton}" Content="Vector"
                        Command="{Binding ShowMarkupValueCommand}" CommandParameter="{x:Vector '1,0'}" />
                <Button Style="{StaticResource SampleButton}" Content="GridLength *"
                        Command="{Binding ShowMarkupValueCommand}" CommandParameter="{x:GridLength *}" />
                <Button Style="{StaticResource SampleButton}" Content="CornerRadius"
                        Command="{Binding ShowMarkupValueCommand}" CommandParameter="{x:CornerRadius 4}" />
            </WrapPanel>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Nullable（无参 = null）" />
            <WrapPanel>
                <Button Style="{StaticResource SampleButton}" Content="NullableInt32 null"
                        Command="{Binding ShowMarkupValueCommand}" CommandParameter="{x:NullableInt32}" />
                <Button Style="{StaticResource SampleButton}" Content="NullableInt32 42"
                        Command="{Binding ShowMarkupValueCommand}" CommandParameter="{x:NullableInt32 42}" />
                <Button Style="{StaticResource SampleButton}" Content="NullableBoolean True"
                        Command="{Binding ShowMarkupValueCommand}" CommandParameter="{x:NullableBoolean True}" />
                <Button Style="{StaticResource SampleButton}" Content="NullableThickness null"
                        Command="{Binding ShowMarkupValueCommand}" CommandParameter="{x:NullableThickness}" />
                <Button Style="{StaticResource SampleButton}" Content="NullablePoint"
                        Command="{Binding ShowMarkupValueCommand}" CommandParameter="{x:NullablePoint '5,6'}" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
